# Copy this to .env for local development. Never commit the filled .env file.
APP_ENV=local
DATA_DIR=data
DATABASE_URL=postgresql+psycopg://trade:trade@localhost:5432/trade_research

# Chat runtime.
CHAT_ENABLED=true
CHAT_STRICT_CITATION_REQUIRED=true
CHAT_USE_LLM_ANSWER=true

# OpenAI embeddings for research document retrieval.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Direct Gemini answer generation.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
CHAT_ANSWER_MODEL=gemini-2.5-flash
CHAT_PLANNER_MODEL=gemini-2.5-flash
CHAT_ANSWER_MAX_OUTPUT_TOKENS=700
CHAT_LLM_TIMEOUT_SECONDS=20
CHAT_LLM_RETRY_ATTEMPTS=3
CHAT_LLM_RETRY_BASE_SECONDS=0.5
CHAT_LLM_THINKING_BUDGET=0

# Local Qdrant research store.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=market_research_documents

# Optional data vendors.
POLYGON_API_KEY=replace-with-your-polygon-api-key-if-used
IBKR_HOST=127.0.0.1
IBKR_PORT=7497

# Ingestion.
YFINANCE_BATCH_SIZE=20
YFINANCE_THROTTLE_SECONDS=1
YFINANCE_MAX_WORKERS=2
YFINANCE_RETRY_ATTEMPTS=3
YFINANCE_RETRY_BASE_SECONDS=1
YFINANCE_JITTER_SECONDS=0.5
HOURLY_REALTIME_LOOKBACK_DAYS=1
HOURLY_HISTORY_LOOKBACK_DAYS=10
HOURLY_BACKLOG_ENABLED=true
HOURLY_BACKLOG_SCAN_DAYS=10
HOURLY_BACKLOG_COVERAGE_THRESHOLD=0.5
HOURLY_BACKLOG_MAX_WINDOWS_PER_TICK=1
HOURLY_BACKLOG_MAX_ATTEMPTS=3
HOURLY_BACKLOG_MIN_CANDLE_LAG_MINUTES=20
HOURLY_BACKLOG_STALE_RECOVERY_MINUTES=30
UNIVERSE_REFRESH_DAYS=7
CALENDAR_REFRESH_DAYS=30
FEED_HEALTH_FAILURE_THRESHOLD=5
FEED_HEALTH_MAX_BACKOFF_HOURS=24
FEED_HEALTH_UNSUPPORTED_RETRY_DAYS=7
