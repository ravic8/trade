# Copy this to .env for local development. Never commit the filled .env file.
APP_ENV=local
DATA_DIR=data
DAGSTER_READONLY_HOME=
DATABASE_URL=postgresql+psycopg://trade:trade@localhost:5432/trade_research
REDIS_URL=redis://localhost:6379/0

# Local Compose feature switches. Profiles start services; switches enable API features.
# These are separate from host-venv settings below.
# Optional overrides for container endpoints (host DATABASE_URL/REDIS_URL stay separate):
# COMPOSE_DATABASE_URL=postgresql+psycopg://trade:trade@postgres:5432/trade_research
# COMPOSE_REDIS_URL=redis://redis:6379/0
# COMPOSE_OBJECT_STORE_ENDPOINT_URL=http://minio:9000

# Daily storage (historical research profile/variable names retained). Services are available through the Compose
# "research" profile, while application reads/writes stay disabled by default.
CLICKHOUSE_ENABLED=false
CLICKHOUSE_WRITE_ENABLED=false
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=research
CLICKHOUSE_USERNAME=api_reader
RESEARCH_STORAGE_ENABLED=false
PHASE3_MARKET_DATA_ENABLED=false
CLICKHOUSE_PASSWORD=
CLICKHOUSE_ADMIN_USER=admin
CLICKHOUSE_ADMIN_PASSWORD=local-clickhouse-admin
CLICKHOUSE_MIGRATION_USER=migration
CLICKHOUSE_MIGRATION_PASSWORD=local-migration
CLICKHOUSE_DAGSTER_USER=dagster_writer
CLICKHOUSE_DAGSTER_PASSWORD=local-dagster-writer
CLICKHOUSE_API_USER=api_reader
CLICKHOUSE_API_PASSWORD=local-api-reader
CLICKHOUSE_ANALYST_USER=analyst_reader
CLICKHOUSE_ANALYST_PASSWORD=local-analyst-reader
OBJECT_STORE_ENABLED=false
OBJECT_STORE_WRITE_ENABLED=false
OBJECT_STORE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
OBJECT_STORE_DAGSTER_ACCESS_KEY_ID=local-dagster-artifacts
OBJECT_STORE_DAGSTER_SECRET_ACCESS_KEY=local-dagster-artifacts-secret
OBJECT_STORE_API_ACCESS_KEY_ID=local-api-artifacts
OBJECT_STORE_API_SECRET_ACCESS_KEY=local-api-artifacts-secret
OBJECT_STORE_RAW_BUCKET=trade-raw
OBJECT_STORE_DATASETS_BUCKET=trade-datasets
OBJECT_STORE_EXPORTS_BUCKET=trade-exports


# Enable these in a deployed environment after supplying real credentials.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=trade-research
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
TELEMETRY_RELEASE=local

# Docker-only MinIO bootstrap values. Rotate outside local development.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin




API_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
ADMIN_EMAILS=
ADMIN_EMAIL_HEADERS=cf-access-authenticated-user-email,x-forwarded-email,x-authenticated-user-email
APP_SECRET_KEY=

# Local Qdrant research store.

# Optional data vendors.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497

# Local refresh cadence.
UNIVERSE_REFRESH_DAYS=7
CALENDAR_REFRESH_DAYS=30

# Phase 3 exchange-session calendars. Keep planning in shadow mode until each
# exchange's materialization run is accepted and its discrepancies are reviewed.
MATERIALIZED_EXCHANGE_SESSIONS_ENABLED=false
EXCHANGE_SESSION_HISTORY_YEARS=1
EXCHANGE_SESSION_FUTURE_YEARS=1
EXCHANGE_SESSION_MINIMUM_OPEN_DAYS_PER_YEAR=220
EXCHANGE_SESSION_MAXIMUM_OPEN_DAYS_PER_YEAR=260
EXCHANGE_SESSION_SHADOW_MAX_DISCREPANCIES=5
EXCHANGE_SESSION_OBSERVED_OPEN_MINIMUM_INSTRUMENTS=10

# Phase 4 Yahoo execution controls. Keep provider execution disabled locally
# unless explicitly testing a small bounded universe.
# Restrict scheduled worker claims when operating one market (NSE, TSX, or US):
TSX_OFFICIAL_ISSUER_URL=https://www.tsx.com/en/resource/571
TSX_OFFICIAL_DIRECTORY_BASE_URL=https://www.tsx.com/json/company-directory
TSX_OFFICIAL_TIMEOUT_SECONDS=30
TSX_OFFICIAL_RETRY_ATTEMPTS=3

# Official NSE final bhavcopy
NSE_DAILY_ENABLED=false
NSE_PUBLICATION_GRACE_MINUTES=120
NSE_RETRY_LOOKBACK_DAYS=7
NSE_REQUEST_INTERVAL_SECONDS=1
