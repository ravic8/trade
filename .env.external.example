# Copy to .env.external; fill endpoints reachable FROM the API container.
# Use a dedicated database and credentials. Never commit the filled file.
COMPOSE_DATABASE_URL=postgresql+psycopg://trade:replace-me@db.example.internal:5432/trade_research
COMPOSE_REDIS_URL=redis://:replace-me@cache.example.internal:6379/0
# PostgreSQL: add ?sslmode=verify-full&sslrootcert=/path/in/container/ca.pem when required.
# Redis: use rediss:// for TLS; supply TLS options appropriate to the service.
RESEARCH_STORAGE_ENABLED=false
OTEL_ENABLED=false
OBJECT_STORE_ENABLED=false
CLICKHOUSE_ENABLED=false
API_PORT=8000
