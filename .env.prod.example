# Copy to /opt/trade/.env on the Ubuntu server and fill the real values there.
# Keep this example file secret-free.

# Public web entrypoint exposed only to localhost for Cloudflare Tunnel.
PROD_WEB_PORT=8080
PROD_API_CORS_ORIGINS=https://trade.example.com

# Persistent server paths.
PROD_TRADE_DATA_DIR=/opt/trade/data
PROD_TRADE_ARTIFACTS_DIR=/opt/trade/artifacts
PROD_POSTGRES_DATA_DIR=/opt/trade/postgres
PROD_REDIS_DATA_DIR=/opt/trade/redis
PROD_QDRANT_DATA_DIR=/opt/trade/qdrant
PROD_DAGSTER_HOME_DIR=/opt/trade/dagster_home
PROD_BACKUP_DIR=/opt/trade/backups

# Database.
PROD_POSTGRES_DB=trade_research
PROD_POSTGRES_USER=trade
PROD_POSTGRES_PASSWORD=replace-with-strong-password
PROD_DATABASE_URL=postgresql+psycopg://trade:replace-with-url-encoded-password@postgres:5432/trade_research

# Provider/runtime secrets. Prefer the browser-managed encrypted Upstox token
# once that admin feature exists; this remains the bootstrap fallback.
PROD_UPSTOX_ACCESS_TOKEN=
PROD_OPENAI_API_KEY=
PROD_GEMINI_API_KEY=
PROD_APP_SECRET_KEY=replace-with-32-byte-random-secret
PROD_ADMIN_EMAILS=you@example.com
PROD_ADMIN_EMAIL_HEADERS=cf-access-authenticated-user-email,x-forwarded-email,x-authenticated-user-email

# Chat and data-pipeline runtime.
PROD_CHAT_ENABLED=true
PROD_CHAT_STRICT_CITATION_REQUIRED=true
PROD_CHAT_USE_LLM_ANSWER=true
PROD_CHAT_ANSWER_MODEL=gemini-2.5-flash
PROD_CHAT_PLANNER_MODEL=gemini-2.5-flash
PROD_CHAT_RATE_LIMIT_ENABLED=true
PROD_CHAT_RATE_LIMIT_REQUESTS=12
PROD_CHAT_RATE_LIMIT_WINDOW_SECONDS=60
PROD_CHAT_RATE_LIMIT_TRUST_FORWARDED_FOR=true
PROD_DATA_PIPELINE_MAX_CONCURRENT_FETCHES=1
PROD_DATA_PIPELINE_THROTTLE_SECONDS=0.25

# Phase 4 Yahoo execution controls. Observation mode records recommendations
# but continues enforcing the initial rate and concurrency.
PROD_YFINANCE_DAILY_ENABLED=false
PROD_YFINANCE_ADAPTIVE_RATE_MODE=observe
PROD_YFINANCE_INITIAL_RPM=300
PROD_YFINANCE_MINIMUM_RPM=30
PROD_YFINANCE_MAXIMUM_RPM=600
PROD_YFINANCE_INITIAL_CONCURRENCY=4
PROD_YFINANCE_MAXIMUM_CONCURRENCY=8
PROD_YFINANCE_IMMEDIATE_RETRY_ATTEMPTS=3
PROD_YFINANCE_RETRY_WAIT_MULTIPLIER_SECONDS=2
PROD_YFINANCE_RETRY_WAIT_MAX_SECONDS=15
PROD_YFINANCE_ADAPTIVE_EVALUATION_WINDOW_SECONDS=60
PROD_YFINANCE_ADAPTIVE_HEALTHY_WINDOWS_BEFORE_INCREASE=2
PROD_YFINANCE_ADAPTIVE_INCREASE_RPM=30
PROD_YFINANCE_ADAPTIVE_ERROR_THRESHOLD=0.10
PROD_YFINANCE_ADAPTIVE_COOLDOWN_SECONDS=60

PROD_MATERIALIZED_EXCHANGE_SESSIONS_ENABLED=false
PROD_EXCHANGE_SESSION_HISTORY_YEARS=10
PROD_EXCHANGE_SESSION_FUTURE_YEARS=1
PROD_EXCHANGE_SESSION_MINIMUM_OPEN_DAYS_PER_YEAR=220
PROD_EXCHANGE_SESSION_MAXIMUM_OPEN_DAYS_PER_YEAR=260
PROD_EXCHANGE_SESSION_SHADOW_MAX_DISCREPANCIES=5
PROD_EXCHANGE_SESSION_OBSERVED_OPEN_MINIMUM_INSTRUMENTS=10

# Internal services.
PROD_QDRANT_API_KEY=
PROD_QDRANT_COLLECTION=market_research_documents

# Optional admin UI. Use an SSH tunnel or Tailscale admin path.
PROD_DAGSTER_WEB_PORT=3000
