# Copy to /opt/trade/.env on the Ubuntu server and fill the real values there.
# Keep this example file secret-free.

# Backend listener, exposed only on loopback.
# trade-web is built and deployed from its own repository.
PROD_API_PORT=8000
PROD_API_CORS_ORIGINS=https://trade.example.com
PROD_API_IMAGE=trade-data-api:local

# Persistent server paths.
PROD_TRADE_DATA_DIR=/opt/trade/data
PROD_DAGSTER_HOME_DIR=/opt/trade/dagster_home
PROD_TRADE_ARTIFACTS_DIR=/opt/trade/artifacts
PROD_POSTGRES_DATA_DIR=/opt/trade/postgres
PROD_REDIS_DATA_DIR=/opt/trade/redis
PROD_MINIO_DATA_DIR=/opt/trade/minio
PROD_CLICKHOUSE_DATA_DIR=/opt/trade/clickhouse
PROD_PROMETHEUS_DATA_DIR=/opt/trade/prometheus
PROD_ALERTMANAGER_DATA_DIR=/opt/trade/alertmanager
PROD_CLOUDBEAVER_WORKSPACE_DIR=/opt/trade/cloudbeaver
PROD_BACKUP_DIR=/opt/trade/backups
PROD_RESTORE_ROOT=/opt/trade/restore-drills
PROD_RESTORE_REPORT_DIR=/opt/trade/restore-reports
TRADE_RESTORE_MAX_RESEARCH_OBJECTS_PER_BUCKET=10000

# Browser SQL access. Configure a separate trusted gateway/tunnel route to the
# private cloudbeaver:8978 Docker endpoint. Drop external identity headers before forwarding.
PROD_CLOUDBEAVER_HOST=sql.example.com
PROD_CLOUDBEAVER_IMAGE=dbeaver/cloudbeaver:26.1.2
PROD_CLOUDBEAVER_SESSION_IDLE_MS=1800000

# Database.
PROD_POSTGRES_DB=trade_research
PROD_POSTGRES_USER=trade
PROD_POSTGRES_PASSWORD=replace-with-strong-password
PROD_POSTGRES_SHM_SIZE=512mb
PROD_POSTGRES_HOST_PORT=5433
PROD_DATABASE_URL=postgresql+psycopg://trade:replace-with-url-encoded-password@postgres:5432/trade_research

# Daily raw evidence storage. Generate distinct MinIO root and application
# credentials on the server; application access must use a separate identity.
PROD_MINIO_ROOT_USER=trade-minio-admin
PROD_MINIO_ROOT_PASSWORD=replace-with-strong-root-password
# Pin this to a tested release in the server environment after the first
# recovery deploy. deploy.sh rejects moves to an older RELEASE tag unless the
# emergency PROD_ALLOW_MINIO_DOWNGRADE override is explicitly enabled.
PROD_MINIO_IMAGE=trade-minio:RELEASE.2025-09-07T16-13-09Z
PROD_MINIO_CLIENT_IMAGE=trade-minio-mc:RELEASE.2025-08-13T08-35-41Z
PROD_ALLOW_MINIO_DOWNGRADE=false
PROD_DEPLOY_STATE_DIR=/opt/trade/deploy-state
# Required before Phase 2 object writes are enabled. Use MinIO KMS or another
# production key manager; never use the repository's local static test key.
PROD_MINIO_KMS_ENABLED=false
PROD_SELF_MANAGED_KES_ENABLED=false
PROD_KES_IMAGE=minio/kes:latest
PROD_KES_CONFIG_DIR=/opt/trade/kes/config
PROD_KES_CERT_DIR=/opt/trade/kes/certs
PROD_KES_KEY_DIR=/opt/trade/kes/keys
PROD_KES_SECRET_DIR=/opt/trade/kes/secrets
PROD_MINIO_KMS_SERVER=https://minio-kms.example.internal:7373
PROD_MINIO_KMS_ENCLAVE=trade-production
PROD_MINIO_KMS_API_KEY=replace-with-minio-kms-api-key
PROD_MINIO_KMS_SSE_KEY=trade-research-sse

# Daily storage (historical research profile/variable names retained). DEPLOY_ENABLED adds the private services to the
# production stack. STORAGE_ENABLED separately activates application access;
# keep it false through schema, canary, RBAC, and restore validation.
# App deployments preserve infrastructure versions. Enable only for a planned storage upgrade.
PROD_UPGRADE_INFRASTRUCTURE=false
# Historical flag/profile names are retained for deployment compatibility.
PROD_RESEARCH_STORAGE_DEPLOY_ENABLED=false
PROD_RESEARCH_STORAGE_ENABLED=false
PROD_CLICKHOUSE_IMAGE=clickhouse:25.8.33.6-jammy
PROD_CLICKHOUSE_ADMIN_USER=admin
PROD_CLICKHOUSE_ADMIN_PASSWORD=replace-with-strong-admin-password
PROD_CLICKHOUSE_MIGRATION_USER=migration
PROD_CLICKHOUSE_MIGRATION_PASSWORD=replace-with-strong-migration-password
PROD_CLICKHOUSE_DAGSTER_USER=dagster_writer
PROD_CLICKHOUSE_DAGSTER_PASSWORD=replace-with-strong-dagster-password
PROD_CLICKHOUSE_API_USER=api_reader
PROD_PHASE3_MARKET_DATA_ENABLED=false
PROD_PHASE3_YFINANCE_ADAPTER_VERSION=yfinance-v1
PROD_CLICKHOUSE_API_PASSWORD=replace-with-strong-api-password
PROD_CLICKHOUSE_ANALYST_USER=analyst_reader
PROD_CLICKHOUSE_ANALYST_PASSWORD=replace-with-strong-analyst-password
PROD_CLICKHOUSE_MEMORY_LIMIT=4g
PROD_CLICKHOUSE_CPU_LIMIT=2.0
PROD_CLICKHOUSE_LOG_MAX_SIZE=50m
PROD_CLICKHOUSE_LOG_MAX_FILES=5
PROD_OBJECT_STORE_REGION=us-east-1
PROD_OBJECT_STORE_RAW_BUCKET=trade-raw
PROD_OBJECT_STORE_DATASETS_BUCKET=trade-datasets
PROD_OBJECT_STORE_EXPORTS_BUCKET=trade-exports
PROD_OBJECT_STORE_DAGSTER_ACCESS_KEY_ID=trade-dagster-artifacts
PROD_OBJECT_STORE_DAGSTER_SECRET_ACCESS_KEY=replace-with-strong-dagster-object-secret
PROD_OBJECT_STORE_API_ACCESS_KEY_ID=trade-api-artifacts
PROD_OBJECT_STORE_API_SECRET_ACCESS_KEY=replace-with-strong-api-object-secret
PROD_OBJECT_STORE_SERVER_SIDE_ENCRYPTION=AES256

# Lens telemetry. OTLP, Prometheus, and Alertmanager remain private on the
# Compose network. Deployment creates the file-backed Alertmanager webhook
# token if it is absent. Langfuse stays disabled until real project keys are
# installed in /opt/trade/.env.
PROD_OTEL_ENABLED=true
PROD_OTEL_SERVICE_NAME=trade-research
PROD_TELEMETRY_RELEASE=production
PROD_OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:latest
PROD_PROMETHEUS_IMAGE=prom/prometheus:latest
PROD_PROMETHEUS_UID=1000
PROD_PROMETHEUS_GID=1000
PROD_PROMETHEUS_RETENTION=30d
PROD_ALERTMANAGER_IMAGE=prom/alertmanager:latest
PROD_ALERTMANAGER_UID=1000
PROD_ALERTMANAGER_GID=1000


# Provider/runtime secrets. Prefer the browser-managed encrypted Upstox token
# once that admin feature exists; this remains the bootstrap fallback.
PROD_UPSTOX_ACCESS_TOKEN=
PROD_APP_SECRET_KEY=replace-with-32-byte-random-secret
PROD_ADMIN_EMAILS=you@example.com
PROD_ADMIN_EMAIL_HEADERS=cf-access-authenticated-user-email,x-forwarded-email,x-authenticated-user-email

# Daily data-pipeline runtime.
PROD_DATA_PIPELINE_MAX_CONCURRENT_FETCHES=1
PROD_DATA_PIPELINE_THROTTLE_SECONDS=0.25

# Phase 4 Yahoo execution controls. Observation mode records recommendations
# but continues enforcing the initial rate and concurrency.
PROD_YFINANCE_DAILY_ENABLED=false
PROD_YFINANCE_DAILY_WORKER_EXCHANGE=NSE
PROD_YFINANCE_FULL_US_ENABLED=false
PROD_YFINANCE_FULL_TSX_ENABLED=false
PROD_YFINANCE_TSX_CANARY_ENABLED=false
PROD_YFINANCE_TSX_CANARY_MAX_SYMBOLS=100
PROD_YFINANCE_NSE_CANARY_ENABLED=false
PROD_YFINANCE_NSE_CANARY_MAX_SYMBOLS=100
PROD_YFINANCE_PROVIDER_HISTORY_EVIDENCE_ENABLED=false
PROD_YFINANCE_SPARSE_HISTORY_MINIMUM_EXPECTED_ROWS=220
PROD_YFINANCE_SPARSE_HISTORY_MAXIMUM_OBSERVED_ROWS=5
PROD_YFINANCE_NSE_ENABLED=false
PROD_NSE_DAILY_PRIMARY_SOURCE=yfinance
PROD_NSE_PROVIDER_COMPARISON_SESSIONS=20
PROD_NSE_PROVIDER_COMPARISON_MINIMUM_SYMBOLS=100
PROD_NSE_PROVIDER_COMPARISON_MINIMUM_ROW_OVERLAP=0.95
PROD_NSE_PROVIDER_COMPARISON_CLOSE_TOLERANCE=0.01
PROD_NSE_PROVIDER_COMPARISON_MINIMUM_CLOSE_MATCH=0.98
PROD_NSE_PROVIDER_COMPARISON_MAXIMUM_SESSION_LAG=1
PROD_LEGACY_UPSTOX_NSE_ENABLED=false
PROD_YFINANCE_ADAPTIVE_RATE_MODE=observe
PROD_YFINANCE_INITIAL_RPM=300
PROD_YFINANCE_MINIMUM_RPM=30
PROD_YFINANCE_MAXIMUM_RPM=600
PROD_YFINANCE_INITIAL_CONCURRENCY=4
PROD_YFINANCE_MAXIMUM_CONCURRENCY=8
PROD_YFINANCE_IMMEDIATE_RETRY_ATTEMPTS=3
PROD_YFINANCE_RETRY_WAIT_MULTIPLIER_SECONDS=2
PROD_YFINANCE_RETRY_WAIT_MAX_SECONDS=15
PROD_YFINANCE_NEW_LISTING_GRACE_HOURS=72
PROD_YFINANCE_NEW_LISTING_RETRY_HOURS=6
PROD_YFINANCE_PROVIDER_GRACE_MINUTES=120
PROD_YFINANCE_ADAPTIVE_EVALUATION_WINDOW_SECONDS=60
PROD_YFINANCE_ADAPTIVE_HEALTHY_WINDOWS_BEFORE_INCREASE=2
PROD_YFINANCE_ADAPTIVE_INCREASE_RPM=30
PROD_YFINANCE_ADAPTIVE_ERROR_THRESHOLD=0.10
PROD_YFINANCE_ADAPTIVE_COOLDOWN_SECONDS=60
PROD_YFINANCE_BACKFILL_YEARS=10
PROD_YFINANCE_WORK_PLANNER_CHUNK_SIZE=250
PROD_YFINANCE_WORK_CLAIM_SIZE=100
PROD_YFINANCE_WORK_HEARTBEAT_SECONDS=30
PROD_YFINANCE_WORK_STALE_MINUTES=10
PROD_YFINANCE_WORK_MAX_ATTEMPTS=9

PROD_MATERIALIZED_EXCHANGE_SESSIONS_ENABLED=false
PROD_EXCHANGE_SESSION_HISTORY_YEARS=10
PROD_EXCHANGE_SESSION_FUTURE_YEARS=1
PROD_EXCHANGE_SESSION_MINIMUM_OPEN_DAYS_PER_YEAR=220
PROD_EXCHANGE_SESSION_MAXIMUM_OPEN_DAYS_PER_YEAR=260
PROD_EXCHANGE_SESSION_SHADOW_MAX_DISCREPANCIES=5
PROD_EXCHANGE_SESSION_OBSERVED_OPEN_MINIMUM_INSTRUMENTS=10

# Internal services.

# Optional admin UI. Use an SSH tunnel or Tailscale admin path.
PROD_DAGSTER_WEB_PORT=3000
