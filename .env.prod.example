# Copy this to .env.prod on the Ubuntu host. Never commit the filled file.
APP_ENV=production
DATA_DIR=/app/data

# Keep the password and DATABASE_URL in sync.
POSTGRES_DB=trade_research
POSTGRES_USER=trade
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://trade:replace-with-a-long-random-password@postgres:5432/trade_research

# Public hostname for Caddy automatic HTTPS, for example lens.example.com.
# Use localhost only for host-local smoke tests.
LENS_DOMAIN=lens.example.com

# Caddy protects the public site and API with HTTP Basic Authentication.
# Store a Caddy password hash here, not the plaintext password.
LENS_BASIC_AUTH_USER=replace-with-public-login-user
LENS_BASIC_AUTH_HASH=replace-with-caddy-password-hash

# Dagster stays host-local. Change the port if the Ubuntu host already uses 3000.
DAGSTER_HOST_BIND_IP=127.0.0.1
DAGSTER_HOST_PORT=3000

# Chat and research stores.
CHAT_ENABLED=true
CHAT_STRICT_CITATION_REQUIRED=true
CHAT_USE_LLM_ANSWER=false
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=market_research_documents

# OpenAI embeddings remain available for research document retrieval.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Direct Gemini answer generation.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
CHAT_ANSWER_MODEL=gemini-2.5-flash
CHAT_PLANNER_MODEL=gemini-2.5-flash
CHAT_ANSWER_MAX_OUTPUT_TOKENS=700
CHAT_LLM_TIMEOUT_SECONDS=20
CHAT_LLM_RETRY_ATTEMPTS=3
CHAT_LLM_RETRY_BASE_SECONDS=0.5
CHAT_LLM_THINKING_BUDGET=0
API_CORS_ORIGINS=https://lens.example.com
CHAT_RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_REQUESTS=12
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_TRUST_FORWARDED_FOR=true

# Optional data vendors.
POLYGON_API_KEY=

# Ingestion.
YFINANCE_BATCH_SIZE=20
YFINANCE_THROTTLE_SECONDS=1
YFINANCE_MAX_WORKERS=2
YFINANCE_RETRY_ATTEMPTS=3
YFINANCE_RETRY_BASE_SECONDS=1
YFINANCE_JITTER_SECONDS=0.5
HOURLY_REALTIME_LOOKBACK_DAYS=1
HOURLY_HISTORY_LOOKBACK_DAYS=10
HOURLY_BACKLOG_ENABLED=true
HOURLY_BACKLOG_SCAN_DAYS=10
HOURLY_BACKLOG_COVERAGE_THRESHOLD=0.5
HOURLY_BACKLOG_MAX_WINDOWS_PER_TICK=1
HOURLY_BACKLOG_MAX_ATTEMPTS=3
HOURLY_BACKLOG_MIN_CANDLE_LAG_MINUTES=20
HOURLY_BACKLOG_STALE_RECOVERY_MINUTES=30
UNIVERSE_REFRESH_DAYS=7
CALENDAR_REFRESH_DAYS=30
FEED_HEALTH_FAILURE_THRESHOLD=5
FEED_HEALTH_MAX_BACKOFF_HOURS=24
FEED_HEALTH_UNSUPPORTED_RETRY_DAYS=7
