{
  "folders": {},
  "connections": {
    "trade-analytics-postgres": {
      "provider": "postgresql",
      "driver": "postgres-jdbc",
      "name": "Trade Analytics PostgreSQL",
      "description": "Curated, read-only analytics views from the operational PostgreSQL source of truth.",
      "configuration": {
        "host": "postgres",
        "port": "5432",
        "database": "trade_research",
        "url": "jdbc:postgresql://postgres:5432/trade_research",
        "configurationType": "MANUAL",
        "type": "prod",
        "closeIdleConnection": true,
        "auth-model": "native",
        "bootstrap": {
          "autocommit": true
        }
      }
    }
  }
}
