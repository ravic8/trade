# Build the preserved community release from its immutable upstream source.
# Its former Docker Hub and Quay images are no longer published.
FROM golang:1.25-bookworm AS build
WORKDIR /source
RUN git init . && git remote add origin https://github.com/minio/minio.git \
    && git fetch --depth 1 origin 07c3a429bfed433e49018cb0f78a52145d4bedeb \
    && git checkout --detach FETCH_HEAD
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags='-s -w -X github.com/minio/minio/cmd.Version=RELEASE.2025-09-07T16-13-09Z -X github.com/minio/minio/cmd.ReleaseTag=RELEASE.2025-09-07T16-13-09Z -X github.com/minio/minio/cmd.CommitID=07c3a429bfed433e49018cb0f78a52145d4bedeb' \
    -o /out/minio .
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/minio /usr/local/bin/minio
COPY --from=build /source/LICENSE /usr/share/doc/minio/LICENSE
ENTRYPOINT ["minio"]
